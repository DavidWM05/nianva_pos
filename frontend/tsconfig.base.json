{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "paths": {
      "@nianva/api-contrato": ["./libs/api-contrato/src/index.ts"],
      "@nianva/core-http": ["./libs/core/http/src/index.ts"],
      "@nianva/domain-ventas-plazos": ["./libs/domain/ventas-plazos/src/index.ts"],
      "@nianva/domain-notas-credito": ["./libs/domain/notas-credito/src/index.ts"],
      "@nianva/domain-gift-cards": ["./libs/domain/gift-cards/src/index.ts"],
      "@nianva/domain-cuentas-pagar": ["./libs/domain/cuentas-pagar/src/index.ts"],
      "@nianva/domain-cuentas-cobrar": ["./libs/domain/cuentas-cobrar/src/index.ts"],
      "@nianva/domain-auditoria": ["./libs/domain/auditoria/src/index.ts"],
      "@nianva/domain-administracion": ["./libs/domain/administracion/src/index.ts"],
      "@nianva/domain-nucleo": ["./libs/domain/nucleo/src/index.ts"],
      "@nianva/ui-tokens": ["./libs/ui/tokens/src/index.ts"],
      "@nianva/ui-format": ["./libs/ui/format/src/index.ts"],
      "@nianva/ui-actions": ["./libs/ui/actions/src/index.ts"],
      "@nianva/ui-data": ["./libs/ui/data/src/index.ts"],
      "@nianva/ui-feedback": ["./libs/ui/feedback/src/index.ts"],
      "@nianva/ui-forms": ["./libs/ui/forms/src/index.ts"],
      "@nianva/ui-layout": ["./libs/ui/layout/src/index.ts"],
      "@nianva/ui-overlays": ["./libs/ui/overlays/src/index.ts"],
      "@nianva/ui-report": ["./libs/ui/report/src/index.ts"],
      "@nianva/ui-shared": ["./libs/ui-shared/src/index.ts"],
      "@nianva/generadores": ["./tools/generadores"]
    }
  }
}
